# --- Discord -----------------------------------------------------------------
# A *bot* token from https://discord.com/developers/applications (never a user token).
DISCORD_TOKEN=
# The server to clone and bridge (right-click the server → Copy Server ID).
DISCORD_GUILD_ID=
# Optional: a permanent invite shown by Vector's /discord command (otherwise the bot makes one).
DISCORD_INVITE_URL=

# --- Vector ------------------------------------------------------------------
# The bridge bot's key (nsec1… or 64-char hex). Leave empty to create/reuse one in VECTOR_DATA_DIR.
VECTOR_NSEC=
VECTOR_DATA_DIR=./vector-bot-data
# Optional: clone into an existing Community (the bot must be its owner/admin). Empty = create a new one.
VECTOR_COMMUNITY_ID=
# Optional: relays for a newly created Community, comma separated (empty = SDK defaults).
VECTOR_RELAYS=
# Optional: naddr of a Vector emoji pack with the server's emoji (see `vdbridge emojis`).
VECTOR_EMOJI_PACK=

# --- Clone -------------------------------------------------------------------
# Copy the last N messages of every text channel (0 = structure only).
CLONE_HISTORY=0
# Channels hidden from @everyone on Discord: private (encrypted Vector private channel),
# overwrite (normal channel + view_channel deny) or skip.
HIDDEN_CHANNELS=private
# Seconds between Vector structure changes (each one is a signed Community update).
CLONE_DELAY=0.5

# --- Bridge ------------------------------------------------------------------
BRIDGE_DB=bridge.db
# Mirror Discord channel/role/server changes onto Vector while running.
SYNC_STRUCTURE=true
# Relay messages posted by other Discord bots.
RELAY_BOTS=true
# Post Vector messages through webhooks (own name + avatar). false = the bot posts "**name**: text".
USE_WEBHOOKS=true
NAME_SUFFIX= (Vector)
MAX_ATTACHMENT_MB=25
# On restart, relay Vector messages missed while offline if younger than this.
CATCH_UP_HOURS=24
# Forget message links older than this many days (edits/deletes stop following them).
PRUNE_DAYS=90
